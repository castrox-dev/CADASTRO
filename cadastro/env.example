# Copie para `.env` na mesma pasta (`cadastro/.env`) e preencha os valores.
# Nunca commite o arquivo `.env`.

# --- Produção: obrigatório definir explicitamente ---
SECRET_KEY=gere-uma-string-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br
# Domínios HTTPS para CSRF (com esquema). Separados por vírgula.
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Opcional: redirecionar HTTP→HTTPS no Django (atrás de proxy use também SECURE_PROXY já ativo)
SECURE_SSL_REDIRECT=False
# HSTS (só ative depois de HTTPS estável). Ex.: 31536000 = 1 ano
SECURE_HSTS_SECONDS=0

# Se rodar DEBUG=False localmente sem HTTPS, pode precisar:
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Banco (PostgreSQL recomendado em produção) ---
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

# --- Mídia em nuvem (recomendado em produção sem disco persistente) ---
# Deixe CLOUDINARY_CLOUD_NAME vazio para usar pasta media/ local (menos ideal em PaaS).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- IXC --------------------------------------------------------------------
# Apenas conexão e flags de comportamento. Todos os IDs de negócio
# (filial / cidade / setor / plano / carteira / vencimento / tipo de documento /
# produto de instalação / fidelidade / vendedor) vivem no painel
# /admin-dash/operacao/, com defaults documentados em cadastros/ixc_ids.py.
# ----------------------------------------------------------------------------

IXC_API_URL=
IXC_API_TOKEN=
IXC_LEAD_RESOURCE=
# True (recomendado) = só POST em ``contato`` na etapa 1 — evita venda/login variável do IXC ao tentar crm_leads.
IXC_LEAD_CONTATO_ONLY=True
# Só tem efeito se IXC_LEAD_CONTATO_ONLY=False. Se o WS ``contato`` falhar, tenta crm_leads / crm_sp_leads / crm_lead.
IXC_LEAD_AFTER_CONTATO_TRY_CRM=False
# True = não chama o webservice de lead de novo se já existir ixc_lead_id no cadastro. False = sempre tenta criar lead.
IXC_REUSE_LOCAL_LEAD_ID=False

# Override de EMERGÊNCIA para forçar IDs em um ambiente específico (homologação/demo).
# Em produção deixe TODOS vazios — a configuração vem do painel Operação + ixc_ids.py.
IXC_FORCE_PLANO_VENDA_ID=
IXC_FORCE_CANAL_VENDA_ID=
IXC_DEFAULT_CANAL_VENDA_ID=
IXC_FORCE_CAMPANHA_ID=
IXC_DEFAULT_CAMPANHA_ID=
# True = envia id_campanha com o mesmo ID resolvido para canal (só se no seu IXC o combo Campanha receber esse FK).
IXC_SEND_CANAL_AS_ID_CAMPANHA=False

# Etapa 2 (prospecção) é no botão / confirmação do sistema; esta flag só vale para uso programático de create_crm_prospect sem force.
IXC_CREATE_CRM_PROSPECT=False
# Nome exato do recurso WS para prospect (opcional). Padrão no código: `crm_canditados` (doc IXC) depois `crm_prospect`.
IXC_CRM_PROSPECT_RESOURCE=
IXC_CRM_PROSPECT_FALLBACK_RESOURCES=
# Após lead com sucesso: POST em crm_candidatos (vínculo id_contato/id_lead). False = só lead.
IXC_CHAIN_CRM_CANDIDATOS_AFTER_LEAD=True
IXC_CRM_CANDIDATOS_RESOURCE=
IXC_CRM_CANDIDATOS_FALLBACK_RESOURCES=
IXC_CREATE_CRM_CANDIDATOS=True
# `crm_canditados` exige FK `cidade`. Se a cidade não estiver cadastrada no painel
# Operação (sem `ixc_cidade_id`) o WS recebe este número como fallback.
IXC_CRM_CANDIDATOS_CIDADE_FALLBACK=1

# Lead «alterar» (não usar em produção; pode duplicar o lead).
IXC_LEAD_POST_ALTERAR=False

# --- cliente_contrato (assinatura digital) ----------------------------------
# Recurso WS opcional do «2º POST» (aguardando assinatura). O número varia por instalação IXC.
# IXC_CLIENTE_CONTRATO_RESOURCE=cliente_contrato
# IXC_CLIENTE_CONTRATO_ASSINATURA_RESOURCE=cliente_contrato_23529
# IXC_CLIENTE_CONTRATO_ASSINATURA_JSON_KEY=id_contrato
# IXC_CLIENTE_CONTRATO_ASSINATURA_IXCSOFT=
# IXC_CONTRATO_AGUARDANDO_ASSINATURA_INCLUIR=True
# IXC_CONTRATO_TEST_ASSINATURA_DIGITAL=S
# IXC_CONTRATO_TEST_INTEGRACAO_ASSINATURA_DIGITAL=
# IXC_CONTRATO_TEST_GERAR_FINAN_ASSIN_DIGITAL=
# IXC_CONTRATO_TEST_STATUS=

# Sincroniza o `tipo` do contrato com o `tipo` do plano de venda (recomendado).
# IXC_CONTRATO_TEST_TIPO_SINCR_COM_PLANO=True
# IXC_CONTRATO_TEST_TIPO=I

# --- Legado (mantido só para compatibilidade) -------------------------------
# Use o painel Operação em vez destes campos. Os DEFAULTS de produção estão
# em cadastros/ixc_ids.py (FILIAIS / SETORES / PLANOS / CARTEIRAS / etc.).
# Mantidos vazios para não interferir no fluxo padrão.
IXC_CONTRATO_TEST_ID_CLIENTE=
IXC_CONTRATO_TEST_ID_VENDEDOR=
IXC_CONTRATO_TEST_ID_MODELO=1
IXC_CONTRATO_TEST_TIPO_COBRANCA_ID=P
# Endpoint para listar `vd_contrato` (sincroniza FKs do contrato com o plano).
# IXC_VD_CONTRATO_RESOURCE=vd_contrato
