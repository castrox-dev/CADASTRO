# Copie para `.env` na mesma pasta (`cadastro/.env`) e preencha os valores.
# Nunca commite o arquivo `.env`.

# --- Produção: obrigatório definir explicitamente ---
SECRET_KEY=gere-uma-string-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seudominio.com.br,www.seudominio.com.br
# Domínios HTTPS para CSRF (com esquema). Separados por vírgula.
CSRF_TRUSTED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br

# Opcional: redirecionar HTTP→HTTPS no Django (atrás de proxy use também SECURE_PROXY já ativo)
SECURE_SSL_REDIRECT=False
# HSTS (só ative depois de HTTPS estável). Ex.: 31536000 = 1 ano
SECURE_HSTS_SECONDS=0

# Se rodar DEBUG=False localmente sem HTTPS, pode precisar:
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# --- Banco (PostgreSQL recomendado em produção) ---
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

# --- Mídia em nuvem (recomendado em produção sem disco persistente) ---
# Deixe CLOUDINARY_CLOUD_NAME vazio para usar pasta media/ local (menos ideal em PaaS).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- IXC --------------------------------------------------------------------
# ATENÇÃO — IDs «fixos» no .env / defaults em settings.py / mapas em integrations.py
# são APENAS para HOMOLOGAÇÃO e TESTES (ex.: demo IXC, Postman de referência).
# Em produção real os IDs vêm do SEU IXC (por cidade): filial, carteira de cobrança,
# tipo de documento, modelo, vendedor, planos de venda (vd), leads, canais de venda,
# campanhas, recurso cliente_contrato_<n> de assinatura, etc. Tudo isso será trocado
# quando você cadastrar por cidade no painel Operação (PlanoDefinicao, CidadeOperacao,
# OrigemCanalVenda, …) e/ou enviar os IDs definitivos por ambiente no .env.
# O código já prioriza Operação + .env; mapas FILIAIS_MAP / PLANOS_MAP / ORIGENS_MAP
# são fallback legado — não são os IDs finais da Fibramar.
# ----------------------------------------------------------------------------

IXC_API_URL=
IXC_API_TOKEN=
IXC_LEAD_RESOURCE=
# True (recomendado) = só POST em ``contato`` na etapa 1 — evita venda/login variável do IXC ao tentar crm_leads.
IXC_LEAD_CONTATO_ONLY=True
# Só tem efeito se IXC_LEAD_CONTATO_ONLY=False. Se o WS ``contato`` falhar, tenta crm_leads / crm_sp_leads / crm_lead.
IXC_LEAD_AFTER_CONTATO_TRY_CRM=False
# True = não chama o webservice de lead de novo se já existir ixc_lead_id no cadastro. False = sempre tenta criar lead.
IXC_REUSE_LOCAL_LEAD_ID=False
# Opcional: sobrescreve plano de venda e canal no webservice. Ex. demo IXC: 1 e 1.
IXC_FORCE_PLANO_VENDA_ID=
IXC_FORCE_CANAL_VENDA_ID=
# Opcional: se plano/canal ainda vierem vazios após Operação (PlanoDefinicao / OrigemCanalVenda), preencha com os IDs do seu IXC.
IXC_DEFAULT_PLANO_VENDA_ID=
IXC_DEFAULT_CANAL_VENDA_ID=
# Plano na tela IXC = input#id_vd_contrato — o payload envia id_vd_contrato junto de id_plano_venda.
# Canal na tela IXC = input#id_candidato_tipo — o payload envia id_candidato_tipo junto de id_canal_venda.
# Campanha = input#id_campanha (não é sempre o mesmo que «Canal de venda»). IDs específicos da grid Campanhas:
IXC_FORCE_CAMPANHA_ID=
IXC_DEFAULT_CAMPANHA_ID=
# True = envia id_campanha com o mesmo ID resolvido para canal (só se no seu IXC o combo Campanha receber esse FK).
IXC_SEND_CANAL_AS_ID_CAMPANHA=False
# Etapa 2 (prospecção) é no botão / confirmação do sistema; esta flag só vale para uso programático de create_crm_prospect sem force.
IXC_CREATE_CRM_PROSPECT=False
# Nome exato do recurso WS para prospect (opcional). Padrão no código: `crm_canditados` (doc IXC) depois `crm_prospect`.
IXC_CRM_PROSPECT_RESOURCE=
# Opcional: após os padrões, tenta estes recursos NA ORDEM (só o que o Postman do SEU provedor listar).
# Ex.: IXC_CRM_PROSPECT_FALLBACK_RESOURCES=crm_prospeccao,outro_recurso
# No demo público deixe vazio — quase nunca há prospecção no webservice. Em produção, copie os nomes exatos da doc.
IXC_CRM_PROSPECT_FALLBACK_RESOURCES=
# Após lead com sucesso: POST em crm_candidatos (vínculo id_contato/id_lead). False = só lead.
IXC_CHAIN_CRM_CANDIDATOS_AFTER_LEAD=True
# Recurso WS candidatos (opcional). Vazio = tenta ``crm_canditados`` (typo URL IXC) depois ``crm_candidatos`` + CSV abaixo.
IXC_CRM_CANDIDATOS_RESOURCE=
IXC_CRM_CANDIDATOS_FALLBACK_RESOURCES=
IXC_CREATE_CRM_CANDIDATOS=True
# ``crm_canditados`` exige FK ``cidade`` (Postman). Se o slug não tiver ``ixc_cidade_id`` na Operação, use o ID IXC aqui.
IXC_CRM_CANDIDATOS_CIDADE_FALLBACK=1
# Opcional (homologação): hoje o lead NÃO mescla estes IDs no JSON; deixe vazio em produção se não usar outro fluxo que os leia.
IXC_CONTRATO_PLANO_VENDA_ID=
IXC_CONTRATO_TIPO_COBRANCA_ID=
IXC_CONTRATO_MODELO_IMPRESSAO_ID=
IXC_CONTRATO_CARTEIRA_COBRANCA_ID=
IXC_CONTRATO_VENDEDOR_ID=
# Integração IXC ativa neste portal: lead/contato + encadeamento ``crm_canditados``.
# False = só 1 POST (incluir). True = incluir + alterar com payload completo (pode duplicar lead no seu IXC).
IXC_LEAD_POST_ALTERAR=False

# --- Opcional: teste WS cliente_contrato (não faz parte do fluxo padrão lead + crm_canditados)
# IXC_CLIENTE_CONTRATO_RESOURCE=cliente_contrato
# Após incluir: POST /webservice/v1/<recurso> com {"id_contrato":"<id>"} — «aguardando assinatura digital» (número varia por instalação IXC).
# Padrão no settings: cliente_contrato_23529; use vazio para desativar o 2º POST.
# IXC_CLIENTE_CONTRATO_ASSINATURA_RESOURCE=cliente_contrato_23529
# IXC_CLIENTE_CONTRATO_ASSINATURA_JSON_KEY=id_contrato
# IXC_CLIENTE_CONTRATO_ASSINATURA_IXCSOFT=
# No mesmo POST incluir: assinatura digital / status (código conforme sua base).
# IXC_CONTRATO_AGUARDANDO_ASSINATURA_INCLUIR=True
# IXC_CONTRATO_TEST_ASSINATURA_DIGITAL=S
# IXC_CONTRATO_TEST_INTEGRACAO_ASSINATURA_DIGITAL=
# IXC_CONTRATO_TEST_GERAR_FINAN_ASSIN_DIGITAL=
# IXC_CONTRATO_TEST_STATUS=
# True = lê ``tipo`` do plano de venda (vd) no IXC e usa no contrato (evita «Tipo do contrato ≠ Tipo do plano»).
# IXC_CONTRATO_TEST_TIPO_SINCR_COM_PLANO=True
# Se o seu IXC não expuser ``vd_contrato`` por listar, defina manualmente a letra do tipo (igual ao plano no IXC):
# IXC_CONTRATO_TEST_TIPO=S
# ID do cliente no IXC. Se vazio: usa ixc_prospect_id (crm_canditados), senão ixc_lead_id (contato).
IXC_CONTRATO_TEST_ID_CLIENTE=
# ID de contrato já existente no IXC (homolog), se usar teste cliente_contrato.
# IXC_CONTRATO_TEST_ID_CONTRATO=
# Se vazio, tenta id do plano (Operação / ixc_plano_venda_id); senão sobrescreva:
# Doc oficial Postman: modelo 1, tipo doc 502, tipo_cobranca P, vendedor 1. Demo IXC costuma usar modelo 4, doc 501, cobrança 10, vendedor 9 — ajuste no .env.
IXC_CONTRATO_TEST_ID_VD_CONTRATO=
IXC_CONTRATO_TEST_ID_FILIAL=
IXC_CONTRATO_TEST_ID_TIPO_CONTRATO=10
IXC_CONTRATO_TEST_ID_MODELO=1
IXC_CONTRATO_TEST_ID_TIPO_DOCUMENTO=502
IXC_CONTRATO_TEST_TIPO_COBRANCA_ID=P
IXC_CONTRATO_TEST_ID_CARTEIRA_COBRANCA=1
IXC_CONTRATO_TEST_ID_VENDEDOR=1
# Recurso WS para listar plano de venda (sincroniza tipo/FKs no teste cliente_contrato).
# IXC_VD_CONTRATO_RESOURCE=vd_contrato
